  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunilksamanta/rest.ts.git"
  },
  "bugs": {
    "url": "https://github.com/sunilksamanta/rest.ts/issues"
  },
  "homepage": "https://github.com/sunilksamanta/rest.ts#readme",
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.8.0",
    "globals": "^15.9.0",
    "inquirer": "^8.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@types/pluralize": "^0.0.33",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "mongoose": "^8.13.2",
    "pluralize": "^8.0.0",
    "reflect-metadata": "^0.2.2"
  }
}
