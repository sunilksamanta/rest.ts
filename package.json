    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint 'src/**/*.ts'",
    "generate": "node scripts/generate.js"
  },
  "keywords": [
    "typescript",
    "nodejs",
    "rest",
    "api",
    "mongodb",
    "mongoose",
    "express",
    "auto-generate",
    "framework"
  ],
